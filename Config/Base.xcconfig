// Committed signing defaults for the Spreek target: ad-hoc, no team, so anyone can build.
// scripts/verify.sh builds with CODE_SIGNING_ALLOWED=NO and ignores these.
//
// Ad-hoc signatures change on every build, so macOS forgets the Accessibility grant after
// each rebuild. To keep it, copy Local.xcconfig.example to Local.xcconfig (git-ignored) and
// fill in your team; it is included below and overrides these values.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
